# 개인 개발자 모드: start:developer 명령이 Extension ID로 자동 설정
THREADFLOW_HOST=127.0.0.1
THREADFLOW_PORT=8787
THREADFLOW_EXTENSION_ORIGINS=chrome-extension://replace-after-install
THREADFLOW_SESSION_SECRET_FILE=.threadflow/session-secret
# 선택값: 비워 두면 Codex 기본 모델과 PATH의 codex를 사용
THREADFLOW_CODEX_MODEL=
THREADFLOW_CODEX_BIN=codex
THREADFLOW_LOG_RETENTION_DAYS=7

# 아래 값은 Phase 8 공식 Threads API Scheduler를 실행할 때만 필요
SCHEDULER_HOST=127.0.0.1
SCHEDULER_PORT=8788
SCHEDULER_DB_PATH=data/threadflow.sqlite
# 로컬 생성: openssl rand -base64 32
SCHEDULER_MASTER_KEY=
# 로컬 생성한 긴 접근 키를 JSON object의 key로 사용
SCHEDULER_ACCESS_KEYS_JSON={"replace-with-long-random-key":{"tenantId":"tenant-local","workspaceId":"workspace-local","userId":"user-local","role":"owner"}}
# Meta 개발자 앱에서만 발급되는 실제 외부 값
META_APP_ID=
META_APP_SECRET=
# Meta 등록값과 문자 단위로 동일해야 함. localhost 불가, HTTPS 필수.
# 공개 HTTPS 터널/Reverse Proxy가 아래 요청을 127.0.0.1:8788로 전달하도록 구성
META_REDIRECT_URI=https://threads-oauth.example.com/v1/threads/oauth/callback
# 선택값
META_GRAPH_VERSION=v1.0
META_USE_PKCE=false
